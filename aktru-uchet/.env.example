PORT=3847
DB_PATH=./data/aktru.db

# Первый администратор: при старте создаётся, если такого email ещё нет.
# Вход — код на эту почту (или на экран, пока не задан SMTP).
ADMIN_EMAIL=admin@example.com

# Аварийный токен (не нужен для обычного входа)
ADMIN_TOKEN=

# Почта для кодов входа. Пока пусто — код пишется в лог сервера и показывается на странице входа.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Актру учёт <noreply@example.com>
